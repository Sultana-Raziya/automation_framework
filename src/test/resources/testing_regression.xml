<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ECommerce Regression Suite"
       parallel="classes"
       thread-count="3">
       
<listeners>
    <listener class-name="retry.RetryTransformer"/>
</listeners>


    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <packages>
            <package name="login"/>
            <package name="inventory"/>
            <package name="cart"/>
            <package name="checkout"/>
        </packages>
    </test>

</suite>
